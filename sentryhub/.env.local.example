# ============================================================
# Copy to .env.local and fill in. Restart `npm run dev` after changes.
# ============================================================

# ---- Supabase (Dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY, never exposed to the browser. Used by webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App URL (used in emails + push links) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated extra Origins allowed to call /api/* from Expo web / previews
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Video provider ----
VIDEO_PROVIDER=mux

# Mux (Dashboard -> Settings -> Access Tokens; create with Video permissions)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
# Mux (Dashboard -> Settings -> Webhooks; the signing secret for your endpoint)
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret

# ---- Email (Resend) ----
# Optional: if unset, email is skipped and in-app + push still work.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=SentryHub <onboarding@resend.dev>

# ---- Web Push (VAPID) ----
# Generate with: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ---- Notification dispatch webhook ----
# Any long random string. Set the SAME value as a custom header
# `x-webhook-secret` on the Supabase Database Webhook for `notifications`.
NOTIFY_WEBHOOK_SECRET=generate-a-long-random-string
